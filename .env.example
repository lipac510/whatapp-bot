# Meta WhatsApp Cloud API
# 不要把真实 Token 发给任何人，也不要提交到公开仓库。

WHATSAPP_ACCESS_TOKEN=replace_with_new_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_real_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_real_waba_id

# Instagram Messaging API (Messenger Platform for Instagram)
# IG 专业号需绑定一个 Facebook Page。同一个 Meta App 时，META_APP_SECRET 与
# WEBHOOK_VERIFY_TOKEN 可复用。Webhook 回调地址：https://<域名>/ig/webhook ，订阅 Instagram 的 messages。
IG_PAGE_ID=replace_with_facebook_page_id
IG_PAGE_ACCESS_TOKEN=replace_with_long_lived_page_access_token

# Webhook
# 这个值由我们自己设置，之后填到 Meta Webhook 验证页面。
WEBHOOK_VERIFY_TOKEN=replace_with_random_verify_token

# 可选：Meta App Secret，后续用于校验 Webhook 签名。
META_APP_SECRET=replace_with_meta_app_secret

# 业务配置
BUSINESS_NAME=Lipack Packaging
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_admin_dashboard_password
TIMEZONE=America/Los_Angeles

# 本地服务
HOST=127.0.0.1
PORT=3000
GRAPH_API_VERSION=v25.0
PUBLIC_BASE_URL=https://wa-customer-info-bot.onrender.com

# Supabase（可选，推荐用于长期保存后台聊天和同步日志）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OKKI CRM
OKKI_API_BASE=https://api-sandbox.xiaoman.cn
OKKI_CLIENT_ID=replace_with_okki_client_id
OKKI_CLIENT_SECRET=replace_with_okki_client_secret
OKKI_SCOPE=company

# 可选：客户来源 ID。现在目标是 OKKI 里的“TK”。
OKKI_ORIGIN_ID=

# 可选：OKKI 跟进人 user_id。现在目标是 contact@cnlipack.com。
OKKI_OWNER_USER_ID=

# 可选：OKKI 自定义字段 ID。
OKKI_INQUIRY_SUMMARY_FIELD_ID=
OKKI_PURCHASE_QUANTITY_FIELD_ID=
OKKI_INQUIRY_PRODUCT_FIELD_ID=
