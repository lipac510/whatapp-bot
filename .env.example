# Meta WhatsApp Cloud API
# 不要把真实 Token 发给任何人，也不要提交到公开仓库。

WHATSAPP_ACCESS_TOKEN=replace_with_new_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_real_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_real_waba_id

# Webhook
# 这个值由我们自己设置，之后填到 Meta Webhook 验证页面。
WEBHOOK_VERIFY_TOKEN=replace_with_random_verify_token

# 可选：Meta App Secret，后续用于校验 Webhook 签名。
META_APP_SECRET=replace_with_meta_app_secret

# 业务配置
BUSINESS_NAME=Lipack Packaging
ADMIN_EMAIL=replace_with_admin_email
TIMEZONE=America/Los_Angeles

# 本地服务
HOST=127.0.0.1
PORT=3000
GRAPH_API_VERSION=v25.0
